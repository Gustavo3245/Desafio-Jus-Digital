{
  "name": "jus-digital",
  "version": "0.12.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docker:down": "docker compose down",
    "docker:install": "docker compose run --rm --no-deps api npm ci",
    "docker:logs": "docker compose logs --follow",
    "docker:ps": "docker compose ps",
    "docker:test": "docker compose run --rm api npm test",
    "docker:up": "docker compose up --build --detach --wait",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"docs/**/*.md\" \"*.md\" package.json",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:install": "npm --prefix frontend ci",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend test",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:manual": "vite --config vite.manual.config.ts",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:cov": "vitest run --coverage --configLoader runner",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --configLoader runner",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --configLoader runner",
    "test:integration": "vitest run --config ./vitest.config.integration.ts --configLoader runner"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@nestjs/authentication": "^0.1.6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "openai": "^7.60.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
